# macOS
.DS_Store
*.swp

# Xcode
*.xcodeproj
*.xcworkspace
xcuserdata/
DerivedData/

# Swift Package Manager
.build/
.swiftpm/
# Package.resolved is intentionally NOT ignored: the MLX packages are pinned only to a major
# version (upToNextMajorVersion), so without the lockfile two machines can resolve different
# minor versions — which makes on-device performance numbers non-reproducible across the team.
# Commit the file Xcode generates at
# MobiCureVN.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Python / MLX Environments
env/
.env/
__pycache__/
*.pyc
*.pyo
*.pyd

# Database (SQLite Memory Store)
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# Keep the RAG vector index — ships inside the iOS app bundle
!Pipeline/vectorstore.db

# IDEs & Editors
.vscode/
.idea/
.history/

# Claude Code (AI assistant memory — local only)
.claude/

# Credentials — never commit real secrets
**/Secrets.swift

# Jupyter Notebook checkpoint
.ipynb_checkpoints/

# Python venv
.venv/


.history/
